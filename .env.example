# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgres://l2g:l2g_dev_password@localhost:5432/l2g_rag

# Claude (Anthropic) — generation + Mode 1 structuring + mode routing
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-opus-4-8

# ColPali embedding service (local Python, added in a later slice)
COLPALI_URL=http://localhost:8000

# Where rasterized page images are written (local storage, not S3)
PAGE_IMAGE_DIR=./data/pages

# Retrieval tuning (two-stage)
COARSE_TOP_K=100
RERANK_TOP_K=5

PORT=3000
