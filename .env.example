# Postgres (matches docker-compose.yml) — host port 5433 to avoid a native Postgres on 5432
DATABASE_URL=postgres://postgres:postgres@localhost:5433/l2g

# Google Gemini
GEMINI_API_KEY=your-key-here

# Models (override if you like)
GEMINI_GENERATE_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Where rasterized page images are written
PAGE_IMAGE_DIR=./data/pages

# Retrieval
RETRIEVE_TOP_K=3

PORT=3000
