# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgres://l2g:l2g_dev_password@localhost:5432/l2g_rag

# Which LLM backend the modes run on: claude (target) | gemini (testing stand-in)
LLM_PROVIDER=claude

# Claude (Anthropic) — the intended backend
ANTHROPIC_API_KEY=""
ANTHROPIC_OPUS_MODEL="claude-opus-4-7"
ANTHROPIC_SONNET_MODEL="claude-sonnet-4-6"

# Gemini (Google) — temporary testing stand-in; set LLM_PROVIDER=gemini to use
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ColPali embedding service (local Python)
COLPALI_URL=http://localhost:8000

# Where rasterized page images are written (local storage, not S3)
PAGE_IMAGE_DIR=./data/pages

# Two-stage retrieval tuning
COARSE_TOP_K=100
RERANK_TOP_K=5

PORT=3000
