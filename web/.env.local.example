# Postgres + pgvector — Supabase (Project Settings -> Database -> Connection string).
# For local Docker Postgres instead, see ../docker-compose.yml.
DATABASE_URL=

# Session token signing — generate with: openssl rand -base64 32
AUTH_SECRET=

# Chat generation — Groq (hosted, free tier, no local load, no API key from
# your own machine needed). Get a free key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# File storage — Supabase Storage. SUPABASE_SERVICE_ROLE_KEY is the
# `service_role` secret key (Project Settings -> API), NOT the public anon
# key — server routes need full access, not the RLS-restricted client key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents
