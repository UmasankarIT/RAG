{
  "name": "l2g-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simple visual RAG for an ophthalmology education platform (Gemini + pgvector)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ingest": "tsx src/ingest/cli.ts",
    "clear": "tsx src/ingest/clear.ts"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "pdf-to-img": "^4.2.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.30.1",
    "pdfkit": "^0.19.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
